#----------------------------------------------------------------------------------
#       Stack Implementation -- Pls not the isempty functio has 2 implementations
# 
#----------------------------------------------------------------------------------
class stack:
    def __init__(self):
        self.slist =  []
    def isempty(self):
        return len(self.slist)==0 # check len and return true when len =0
    def push(self, item):
        self.slist.append(item)
    def pop(self):  
        if not self.isempty():      #check len before popping an element, if the len>0 then pop an element and return
            return self.slist.pop()
    def top(self):
        if not self.isempty():
            return self.slist[-1]

    def isempty2(self):
        #print("ssssss:::", bool(self.slist), not bool(self.slist))
        return not bool(self.slist)    
    def pop2(self):  
        #print('222222222222')
        if not self.isempty2():
            return self.slist.pop()
    def top2(self):
        if not self.isempty2():
            return self.slist[-1]

    def display(self):
        print (self.slist)

# Create a Stack
s = stack()
    
# Push elements
s.push(1)  # Adding 1 to the stack
s.push(2)  # Adding 2 to the stack
s.push(3)  # Adding 3 to the stack
    
# Display the stack
s.display()  # Output: [1, 2, 3]
    
# # Pop elements
print(s.pop2())  # Output: 3 (removing top element)
s.display()  # Output: [1, 2]
    
# # Top element
print(s.top2())  # Output: 2 (top element)
    
# # Check if stack is empty
print(s.isempty())  # Output: False (stack is not empty)
print(s.isempty2())  # Output: False (stack is not empty)

#-------------------End of Program-------------------------------------


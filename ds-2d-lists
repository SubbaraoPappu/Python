#----------------------------------------------------------------------
# gvien a 3x3 2d List find the sum of each row and print then as a simple list
#----------------------------------------------------------------------
def sum_rows(tdl):
    srows=[]
    for i in range(0,len(tdl)):
        sumline=sum(tdl[i])
        #print(f"row {1} sum is: {sr}")
        srows.append(sumline)
    print(srows)    

print(sum_rows([[1, 2, 3], [4, 5, 6], [7, 8, 9]]))  # Output: [6, 15, 24]
print(sum_rows([[1], [2], [3]]))  # Output: [1, 2, 3]
print(sum_rows([[], [], []]))  # Output: [0, 0, 0]

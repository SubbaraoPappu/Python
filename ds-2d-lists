#----------------------------------------------------------------------
# take Two 2x2 lists and add then to make One 2x2 2d List
#----------------------------------------------------------------------
def add_mat(mt1,mt2):
    mf=[]
    num=0
    # print(len(mt1), len(mt2))
    print(f"1st 2D List is : {mt1}")
    print(f"2nd 2D List is : {mt2}")

    for i in range(0,len(mt1)):
        row=[]
        for j in range(0,len(mt1[i])):
            num=mt1[i][j]+mt2[i][j]
            # print(f"mt1  :  {mt1[i][j]},  mt2  :{mt2[i][j]} and sum is {num}")
            row.append(num)
            # print(f"row is : {row}")
        mf.append(row)
    
    return mf

   
print(add_mat([[1, 2], [3, 4]], [[5, 6], [7, 8]]))  # Output: [[6, 8], [10, 12]]
print(add_mat([], []))  # Output: []


